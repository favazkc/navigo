# Server
PORT=4000

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appName>

# JWT (RSA key pair — RS256)
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_EXPIRES_IN=7d

# Amazon Cognito
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_cognito_client_id
COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com

# CORS
APP_URL=http://localhost:2000

# Spring Mail — SendGrid SMTP relay
SPRING_MAIL_HOST=smtp.sendgrid.net
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=apikey
SPRING_MAIL_PASSWORD=SG.your_sendgrid_api_key_here
SPRING_MAIL_FROM=you@example.com
